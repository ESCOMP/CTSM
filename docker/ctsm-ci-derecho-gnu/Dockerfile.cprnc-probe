# THROWAWAY PROBE -- delete once its two layers are folded into Dockerfile.
#
# Proves, on top of the published image, that (1) cprnc builds and links once
# at image-build time against the static serial stack, and (2) the container
# machine override makes case builds use it instead of compiling their own.
# Build with:
#   DOCKERFILE=Dockerfile.cprnc-probe IMAGE_TAG=ctsm-ci-derecho-gnu:cprnc-probe \
#     CTSM_BUILD_NO_SAVE=1 docker/ctsm-ci-derecho-gnu/build-on-casper.sh
FROM ghcr.io/escomp/ctsm/ctsm-ci-derecho-gnu:20261015

SHELL ["/bin/bash", "-c"]
ARG MAKE_JOBS=16

# ---- cprnc, built once here so case builds never build it ----
# Must match the cprnc commit cime records for CIME/non_py/cprnc (v1.1.5 at
# cime6.5.5); bump the two together.
#
# The link libraries come from pkg-config and are appended as
# CMAKE_Fortran_STANDARD_LIBRARIES, i.e. AFTER the two netCDF archives on the
# link line, which is the order a static link needs. That works whatever
# cprnc's CMakeLists does to find netCDF -- which is the point: v1.1.5 finds
# the bare archives with find_library before it ever reaches pkg-config, and
# links them with none of their HDF5/zlib/curl/xml2 dependencies.
#
# Both packages are named because `pkg-config --libs netcdf-fortran` alone
# stops at "-L/usr/local/lib -lnetcdff -lnetcdf"; HDF5 and the rest are only
# in netcdf.pc's answer ("-lnetcdf -lhdf5_hl -lhdf5 -lm -lz -lxml2 -lcurl", as
# the .pc layer printed on 2026-10-15). Measured: the first probe build linked
# with netcdf-fortran's alone and died on undefined H5* symbols. --static is
# belt and braces.
#
# The final check runs cprnc on two copies of its own test file. A link that
# succeeds is not enough: this proves the binary starts and reads netCDF.
# The expected line is cprnc.F90's own wording (write at line 170 in v1.1.5).
ARG CPRNC_VERSION=v1.1.5
RUN set -eu; \
    cd /tmp; \
    git clone --depth 1 --branch "${CPRNC_VERSION}" https://github.com/ESMCI/cprnc; \
    mkdir cprnc/build; cd cprnc/build; \
    cmake .. \
        -DCMAKE_C_COMPILER="${CC}" \
        -DCMAKE_Fortran_COMPILER="${FC}" \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_Fortran_STANDARD_LIBRARIES="$(pkg-config --static --libs netcdf-fortran netcdf)"; \
    make -j"${MAKE_JOBS}" VERBOSE=1; \
    make install; \
    out="$(/usr/local/bin/cprnc ../test_inputs/control.nc ../test_inputs/control.nc)"; \
    echo "$out" | tail -5; \
    echo "$out" | grep -q 'the two files seem to be IDENTICAL' \
        || { echo "ERROR: cprnc does not report a file identical to itself" >&2; exit 1; }; \
    rm -rf /tmp/cprnc

# ---- container machine override: point CCSM_CPRNC at the build above ----
# See the header of cime-machines/container/config_machines.xml. Baked at a
# fixed path and dropped in /root/.cime, the same arrangement as
# cime-macros/gnu_container.cmake.
COPY cime-machines/container/config_machines.xml /opt/ctsm-container/cime-machines/container/
RUN set -eu; \
    mkdir -p /root/.cime/container; \
    cp /opt/ctsm-container/cime-machines/container/config_machines.xml /root/.cime/container/; \
    p="$(sed -n 's:.*<CCSM_CPRNC>\(.*\)</CCSM_CPRNC>.*:\1:p' /root/.cime/container/config_machines.xml)"; \
    [ -x "$p" ] || { echo "ERROR: CCSM_CPRNC='$p' is not an executable" >&2; exit 1; }; \
    echo "CCSM_CPRNC=$p"

LABEL cprnc="${CPRNC_VERSION}"

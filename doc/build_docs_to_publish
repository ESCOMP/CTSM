#!/usr/bin/env bash
set -e

scriptname=build_docs_to_publish

# Ensure we're running from the correct directory.
# Custom addition for CTSM to avoid needing to deal with https://github.com/ESMCI/doc-builder/issues/71 right now. Doesn't fix the "relative paths resolve incorrectly" issue.
SCRIPT_DIR="$(dirname "${BASH_SOURCE[0]}")"
cd "${SCRIPT_DIR}"

. ./build_docs

module test_update_landunit_weights_one_gcell

  ! Tests of the update_landunit_weights_one_gcell routine in the dynLandunitArea module

  use funit
  use dynLandunitAreaMod
  use landunit_varcon, only : istsoil, istcrop, isturb_tbd, isturb_hd, isturb_md, istice, istdlak, istwet, max_lunit
  use shr_kind_mod   , only : r8 => shr_kind_r8
  

  implicit none
  save

  real(r8), parameter :: tol = 1.e-14_r8

contains

  function create_landunit_weights()
    ! Create default version of the landunit weights
    real(r8), dimension(max_lunit), allocatable :: create_landunit_weights(:)

    ! Landunit 3 (previously istice) is currently unused, so set its area to 0.
    create_landunit_weights = [.25_r8, .2_r8, 0._r8, .3_r8, .08_r8, .06_r8, .05_r8, .04_r8, .02_r8]
  end function create_landunit_weights

  function lunit_message(lunit) result(message)
    ! Create a message identifying the given landunit, for use in assertions
    integer, intent(in) :: lunit
    character(len=:), allocatable :: message

    character(len=16) :: lunit_str

    write(lunit_str, '(i0)') lunit
    message = 'landunit ' // trim(lunit_str)
  end function lunit_message

  @Test
  subroutine test_no_change()
    ! Test with no changes needed in landunit areas, because they already add to 100%
    
    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)

    landunit_weights = create_landunit_weights()
    expected = landunit_weights

    call update_landunit_weights_one_gcell(landunit_weights)
    @assertEqual(expected, landunit_weights)
  end subroutine test_no_change

  @Test
  subroutine test_less_than_1()
    ! Test with the input summing to less than 1, which should result in an increase in
    ! the natural vegetated area

    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)
    integer  :: l

    landunit_weights = create_landunit_weights()
    landunit_weights(istice) = landunit_weights(istice) - 0.01_r8
    expected = landunit_weights
    expected(istsoil) = landunit_weights(istsoil) + 0.01_r8

    call update_landunit_weights_one_gcell(landunit_weights)

    ! istsoil is changed by an arithmetic operation, so should match within a tolerance;
    ! all other landunits should be unchanged, so should match exactly
    do l = 1, max_lunit
       if (l == istsoil) then
          @assertEqual(expected(l), landunit_weights(l), tolerance=tol, message=lunit_message(l))
       else
          @assertEqual(expected(l), landunit_weights(l), message=lunit_message(l))
       end if
    end do
  end subroutine test_less_than_1

  @Test
  subroutine test_greater_than_1_one_change()
    ! Test with the input summing to greater than 1, resulting in a change in a single
    ! landunit

    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)
    integer  :: l

    landunit_weights = create_landunit_weights()
    landunit_weights(istice) = landunit_weights(istice) + 0.01_r8
    expected = landunit_weights
    expected(istsoil) = landunit_weights(istsoil) - 0.01_r8

    call update_landunit_weights_one_gcell(landunit_weights)

    ! istsoil is changed by an arithmetic operation, so should match within a tolerance;
    ! all other landunits should be unchanged, so should match exactly
    do l = 1, max_lunit
       if (l == istsoil) then
          @assertEqual(expected(l), landunit_weights(l), tolerance=tol, message=lunit_message(l))
       else
          @assertEqual(expected(l), landunit_weights(l), message=lunit_message(l))
       end if
    end do
  end subroutine test_greater_than_1_one_change

  @Test
  subroutine test_greater_than_1_multiple_changes()
    ! Test with the input summing to greater than 1, resulting in a change in multiple
    ! landunits (but not all landunits)

    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)
    integer  :: l

    landunit_weights = create_landunit_weights()

    ! In the following, we assume that the first few elements of decrease_order are:
    ! istsoil, istcrop, isturb_md
    landunit_weights(istice) = landunit_weights(istice) + &
         landunit_weights(istsoil) + landunit_weights(istcrop) + 0.01_r8
    expected = landunit_weights
    expected(istsoil) = 0._r8
    expected(istcrop) = 0._r8
    expected(isturb_md) = expected(isturb_md) - 0.01_r8
    
    call update_landunit_weights_one_gcell(landunit_weights)

    ! isturb_md is changed by an arithmetic operation, so should match within a
    ! tolerance; istsoil and istcrop should be exactly 0 and all other landunits should be
    ! unchanged, so these should match exactly
    do l = 1, max_lunit
       if (l == isturb_md) then
          @assertEqual(expected(l), landunit_weights(l), tolerance=tol, message=lunit_message(l))
       else
          @assertEqual(expected(l), landunit_weights(l), message=lunit_message(l))
       end if
    end do
  end subroutine test_greater_than_1_multiple_changes

  @Test
  subroutine test_greater_than_1_all_changes()
    ! Test with the input summing to greater than 1, resulting in a change in ALL
    ! landunits (except istice, which is the one set manually here, and which can
    ! never change)

    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)
    integer  :: l

    landunit_weights = create_landunit_weights()
    landunit_weights(istice) = 0.99_r8

    ! In the following, we assume that the last element of decrease_order is istdlak
    expected(:) = 0._r8
    expected(istice) = 0.99_r8
    expected(istdlak) = 0.01_r8
    
    call update_landunit_weights_one_gcell(landunit_weights)

    ! istdlak is changed by an arithmetic operation, so should match within a tolerance;
    ! all other landunits except istice should be exactly 0 and istice should be
    ! unchanged, so these should match exactly
    do l = 1, max_lunit
       if (l == istdlak) then
          @assertEqual(expected(l), landunit_weights(l), tolerance=tol, message=lunit_message(l))
       else
          @assertEqual(expected(l), landunit_weights(l), message=lunit_message(l))
       end if
    end do
  end subroutine test_greater_than_1_all_changes

  @Test
  subroutine test_greater_than_1_all_changes_to_0()
    ! Similar to test_greater_than_1_all_changes, but now all landunits except istice
    ! are reduced to 0

    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)
    integer  :: l

    landunit_weights = create_landunit_weights()
    landunit_weights(istice) = 1.0_r8
    expected(:) = 0._r8
    expected(istice) = 1.0_r8

    call update_landunit_weights_one_gcell(landunit_weights)

    ! All landunits except istice should be exactly 0 and istice should be unchanged, so
    ! all should match exactly
    @assertEqual(expected, landunit_weights)
  end subroutine test_greater_than_1_all_changes_to_0

  @Test
  subroutine test_greater_than_1_all_changes_to_0_roundoff()
    ! Similar to test_greater_than_1_all_changes_to_0, but with an istdlak weight chosen
    ! so that a naive computation of the excess area leaves istdlak with a roundoff-level
    ! positive weight rather than exactly 0

    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)

    landunit_weights = create_landunit_weights()
    landunit_weights(istice) = 1.0_r8
    landunit_weights(istdlak) = 0.2_r8
    expected(:) = 0._r8
    expected(istice) = 1.0_r8

    call update_landunit_weights_one_gcell(landunit_weights)

    ! All landunits except istice should be exactly 0 and istice should be unchanged, so
    ! all should match exactly
    @assertEqual(expected, landunit_weights)
  end subroutine test_greater_than_1_all_changes_to_0_roundoff

  @Test
  subroutine test_greater_than_1_multiple_changes_to_0_roundoff()
    ! Test with the input summing to greater than 1, where the excess is exactly the
    ! weight of istsoil plus istcrop, so these two landunits should go to exactly 0 and
    ! all others should be unchanged. Weights are chosen so that a naive computation of
    ! the excess area leaves istcrop with a roundoff-level positive weight rather than
    ! exactly 0.

    real(r8) :: landunit_weights(max_lunit)
    real(r8) :: expected(max_lunit)

    ! In the following, we assume that the first two elements of decrease_order are:
    ! istsoil, istcrop
    landunit_weights(:) = 0._r8
    landunit_weights(istsoil) = 0.25_r8
    landunit_weights(istcrop) = 0.23_r8
    landunit_weights(istice) = 0.62_r8
    landunit_weights(istdlak) = 0.02_r8
    landunit_weights(istwet) = 0.13_r8
    landunit_weights(isturb_tbd) = 0.07_r8
    landunit_weights(isturb_hd) = 0.12_r8
    landunit_weights(isturb_md) = 0.04_r8
    expected = landunit_weights
    expected(istsoil) = 0._r8
    expected(istcrop) = 0._r8

    call update_landunit_weights_one_gcell(landunit_weights)

    ! istsoil and istcrop should be exactly 0 and all other landunits should be unchanged,
    ! so all should match exactly
    @assertEqual(expected, landunit_weights)
  end subroutine test_greater_than_1_multiple_changes_to_0_roundoff

end module test_update_landunit_weights_one_gcell
